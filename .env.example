# Copy to .env for local dev. Do NOT commit .env.

# Postgres
DATABASE_URL=postgres://craiwl:craiwl@localhost:5432/craiwl

# Redis (BullMQ frontier queue)
REDIS_URL=redis://localhost:6379

# Object store (MinIO locally, S3 in prod)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=craiwl
S3_SECRET_ACCESS_KEY=craiwl-dev-password
S3_BUCKET_SNAPSHOTS=craiwl-snapshots
S3_BUCKET_OUTPUTS=craiwl-outputs
S3_FORCE_PATH_STYLE=true

# Observability
LOG_LEVEL=debug
LOG_PRETTY=1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Anthropic
# ANTHROPIC_API_KEY=
